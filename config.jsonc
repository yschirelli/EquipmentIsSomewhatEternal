{
  // Tier 2: Optionally restore these slots on death (default: keep raid version)
  "RestoreArmBand": false,
  "RestoreSpecialSlots": false,
  "RestoreScabbard": false,
  "RestoreSecuredContainer": false,

  // Tier 3: Only restore Tier 1 equipment that was insured before raid
  "OnlyRestoreInsured": false,

  // Tier 4: Preserve quest items collected during raid on death
  "KeepQuestItems": false
}
